# Resend — email delivery for beta signup
RESEND_API_KEY="re_xxxxx"
RESEND_FROM_EMAIL="Impulse <beta@impulse-app.com>"

# Vercel KV / Upstash Redis — auto-injected by the Vercel KV integration
KV_REST_API_URL="https://xxxxx.upstash.io"
KV_REST_API_TOKEN="xxxxx"

# Public URLs used in beta emails
PUBLIC_APP_URL="https://impulse-eight-lake.vercel.app"
PUBLIC_DOWNLOAD_URL="https://github.com/Izayauh/whisper/releases/tag/v1.0.0-beta.1"

# Optional: used for automated reply routing
RESEND_REPLY_TO="founder@impulse-app.com"

# Optional: protects admin export API
BETA_ADMIN_TOKEN="replace-with-a-long-random-secret"

# Optional: Vercel cron auth
CRON_SECRET="replace-with-a-long-random-secret"
